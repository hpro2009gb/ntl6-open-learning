{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntl6.local/contracts/ASSESSMENT_REQUEST/1.0",
  "title": "ASSESSMENT_REQUEST/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "learner_id",
    "subject",
    "target_concepts",
    "purpose",
    "max_items",
    "time_budget_minutes",
    "difficulty_band",
    "requested_at",
    "parent_constraints"
  ],
  "properties": {
    "contract_version": {
      "const": "ASSESSMENT_REQUEST/1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "enum": [
        "MATH",
        "VIETNAMESE",
        "ENGLISH"
      ]
    },
    "target_concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "purpose": {
      "enum": [
        "DIAGNOSTIC",
        "PRACTICE",
        "REPAIR",
        "FRESH_RECHECK",
        "WEEKLY_CHECK",
        "MOCK"
      ]
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "time_budget_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "difficulty_band": {
      "type": "string",
      "minLength": 1
    },
    "requested_at": {
      "type": "string",
      "minLength": 1
    },
    "parent_constraints": {
      "type": "object"
    }
  }
}
